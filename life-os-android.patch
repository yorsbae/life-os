@@ -0,0 +1,82 @@
+name: Build APK
+
+# Jalankan manual: tab Actions -> "Build APK" -> Run workflow.
+# Atau otomatis saat membuat tag versi, mis. `git tag v1.0.0 && git push --tags`.
+on:
+  workflow_dispatch:
+  push:
+    tags: ["v*"]
+
+jobs:
+  apk:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: npm
+
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: 21
+
+      - name: Install & test
+        run: |
+          npm ci
+          npm test
+
+      - name: Build web + sync Capacitor
+        run: |
+          npm run build
+          npx cap sync android
+
+      # --- APK rilis bertanda tangan (dipakai untuk pemakaian sehari-hari & update) ---
+      - name: Siapkan keystore
+        id: ks
+        env:
+          KEYSTORE_B64: ${{ secrets.LIFEOS_KEYSTORE_BASE64 }}
+        run: |
+          if [ -n "$KEYSTORE_B64" ]; then
+            echo "$KEYSTORE_B64" | base64 -d > "$RUNNER_TEMP/lifeos.keystore"
+            echo "has_key=true" >> "$GITHUB_OUTPUT"
+          else
+            echo "has_key=false" >> "$GITHUB_OUTPUT"
+            echo "::warning::Secret LIFEOS_KEYSTORE_BASE64 belum diisi. Hanya APK debug yang dibuat; APK debug TIDAK bisa di-update di atas versi lain (harus uninstall = data hilang). Lihat README bagian 'Tanda tangan'."
+          fi
+
+      - name: Build APK rilis
+        if: steps.ks.outputs.has_key == 'true'
+        working-directory: android
+        env:
+          LIFEOS_KEYSTORE_PATH: ${{ runner.temp }}/lifeos.keystore
+          LIFEOS_KEYSTORE_PASSWORD: ${{ secrets.LIFEOS_KEYSTORE_PASSWORD }}
+          LIFEOS_KEY_ALIAS: ${{ secrets.LIFEOS_KEY_ALIAS }}
+          LIFEOS_KEY_PASSWORD: ${{ secrets.LIFEOS_KEY_PASSWORD }}
+        run: |
+          chmod +x gradlew
+          ./gradlew assembleRelease
+
+      - name: Upload APK rilis
+        if: steps.ks.outputs.has_key == 'true'
+        uses: actions/upload-artifact@v4
+        with:
+          name: life-os-release
+          path: android/app/build/outputs/apk/release/*.apk
+
+      # --- APK debug (hanya untuk uji coba cepat) ---
+      - name: Build APK debug
+        if: steps.ks.outputs.has_key != 'true'
+        working-directory: android
+        run: |
+          chmod +x gradlew
+          ./gradlew assembleDebug
+
+      - name: Upload APK debug
+        if: steps.ks.outputs.has_key != 'true'
+        uses: actions/upload-artifact@v4
+        with:
+          name: life-os-debug
+          path: android/app/build/outputs/apk/debug/*.apk
